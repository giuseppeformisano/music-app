rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
      // IMPORTANTE: una regola sul documento NON copre le sottocollezioni.
      // Questo wildcard ricorsivo copre users/{id}/notifications/... (richieste
      // di follow, notifiche persistenti) ecc. Senza, il batch atomico di
      // sendFollowRequest falliva e la richiesta non partiva.
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /friend_requests/{requestId} {
      allow read, write: if request.auth != null;
    }
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    match /pulseAudio/{audioId} {
      allow read, write: if request.auth != null;
    }
  }
}
